# Server-only AI providers (Phase 6E). Never use NEXT_PUBLIC_ prefixes.
# Do not commit real values.

# Routing: Gemini is primary; xAI is eligible fallback only.
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=xai
AI_PROVIDER_BUDGET_MS=25000

# Gemini (primary). Get a key at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=10000
GEMINI_MAX_OUTPUT_TOKENS=800

# xAI / Grok (fallback). Get a key at https://console.x.ai
XAI_API_KEY=
AI_PROVIDER_MODEL=grok-4.6
AI_PROVIDER_TIMEOUT_MS=15000
AI_PROVIDER_MAX_OUTPUT_TOKENS=800
